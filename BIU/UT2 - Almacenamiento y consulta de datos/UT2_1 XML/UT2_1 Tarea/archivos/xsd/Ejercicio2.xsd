<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

<xs:element name="cartelera">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="pelicula" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="titulo" type="xs:string"></xs:element>
                        <xs:element name="titulo_original" type="xs:string" minOccurs="0"></xs:element>
                        <xs:element name="nacionalidad" type="xs:string"></xs:element>
                        <xs:element name="genero" type="xs:string"></xs:element>
                        <xs:choice>
                            <xs:element name="clasificacion">
                                <xs:complexType>
                                    <xs:attribute name="edad" use="required">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="tp"></xs:enumeration>
                                                <xs:enumeration value="8"></xs:enumeration>
                                                <xs:enumeration value="12"></xs:enumeration>
                                                <xs:enumeration value="16"></xs:enumeration>
                                                <xs:enumeration value="18"></xs:enumeration>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="sin_clasificar">
                                <xs:complexType></xs:complexType>
                            </xs:element>
                        </xs:choice>
                        <xs:element name="sinopsis" type="xs:string"></xs:element>
                        <xs:element name="director" type="xs:string"></xs:element>
                        <xs:element name="reparto">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="actor" type="xs:string" maxOccurs="unbounded"></xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="web" type="xs:string" minOccurs="0"></xs:element>
                        <xs:element name="cartel" type="xs:string" minOccurs="0"></xs:element>
                    </xs:sequence>
                    <xs:attribute name="codigo" type="xs:ID" use="required"></xs:attribute>
                    <xs:attribute name="duracion" type="xs:integer" use="required"></xs:attribute>
                    <xs:attribute name="ano" type="xs:integer" default="2003"></xs:attribute>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:element>

</xs:schema>