<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="factura">
    <xs:complexType>
        <xs:sequence>
             <xs:element name="datos_empresa">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="nombre" type="xs:string"/>
                        <xs:element name="dir" type="xs:string"/>
                        <xs:element name="poblacion">
                            <xs:complexType>
                                <xs:simpleContent>
                                    <xs:extension base="xs:string">
                                        <xs:attribute name="cod_postal" type="xs:string" use="required"/>
                                    </xs:extension>
                                </xs:simpleContent>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="provincia" type="xs:string"/>
                        <xs:element name="cif" type="xs:string"/>
                        <xs:element name="telefono" type="xs:string" fixed="917776688" minOccurs="0"></xs:element>
                        <xs:element name="fax" type="xs:string" fixed="917776699" minOccurs="0"></xs:element>
                    </xs:sequence>
                </xs:complexType>
             </xs:element>
              <xs:element name="datos_cliente">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="nombre" type="xs:string"></xs:element>
                        <xs:element name="dir_env" type="xs:string"></xs:element>
                        <xs:element name="poblacion">
                            <xs:complexType>
                                <xs:simpleContent>
                                    <xs:extension base="xs:string">
                                        <xs:attribute name="cod_postal" type="xs:string" use="required"></xs:attribute>
                                    </xs:extension>
                                </xs:simpleContent>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="provincia" type="xs:string"></xs:element>
                    </xs:sequence>
                    <xs:attribute name="n_cli" type="xs:ID" use="required"></xs:attribute>
                </xs:complexType>
              </xs:element>
               <xs:element name="datos_factura">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="fecha" type="xs:string"></xs:element>
                        <xs:element name="linea" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="ref" type="xs:string"></xs:element>
                                    <xs:element name="desc" type="xs:string"></xs:element>
                                    <xs:element name="cant" type="xs:string"></xs:element>
                                    <xs:element name="precio" type="xs:string"></xs:element>
                                    <xs:element name="importe" type="xs:string"></xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="base" type="xs:string"></xs:element>
                        <xs:element name="cuota_iva" type="xs:string"></xs:element>
                        <xs:element name="total" type="xs:string"></xs:element>
                    </xs:sequence>
                    <xs:attribute name="n_ped" type="xs:ID" use="required"></xs:attribute>
                    <xs:attribute name="iva" type="xs:integer" use="required"></xs:attribute>
                    <xs:attribute name="f_pago" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="efectivo"></xs:enumeration>
                                <xs:enumeration value="tarjeta"></xs:enumeration>
                                <xs:enumeration value="plazos"></xs:enumeration>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="moneda" type="xs:string" fixed="euro" use="required"></xs:attribute>
                </xs:complexType>
               </xs:element>
        </xs:sequence>
        <xs:attribute name="n_fac" type="xs:ID" use="required"></xs:attribute>
    </xs:complexType>
</xs:element>
</xs:schema>