<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- ============================================================ -->
  <!-- XML Schema para Ejercicio4.xml - Facturas Holded             -->
  <!-- ============================================================ -->

  <xs:element name="facturas">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="factura" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="factura" type="tipoFactura"/>

  <xs:complexType name="tipoFactura">
    <xs:sequence>
      <xs:element name="emisor"   type="tipoEmisor"/>
      <xs:element name="receptor" type="tipoReceptor"/>
      <xs:element name="fecha"    type="xs:date"/>
      <xs:element name="lineas"   type="tipoLineas"/>
      <xs:element name="resumen"  type="tipoResumen"/>
      <xs:element name="pago"     type="tipoPago"/>
    </xs:sequence>
    <xs:attribute name="numero" type="xs:ID"     use="required"/>
    <xs:attribute name="tipo"   type="xs:string" use="required"/>
    <xs:attribute name="moneda" type="xs:string" fixed="euro"/>
  </xs:complexType>

  <xs:complexType name="tipoEmisor">
    <xs:sequence>
      <xs:element name="nombre"               type="xs:string"/>
      <xs:element name="direccion"            type="tipoDireccion"/>
      <xs:element name="identificacion_fiscal" type="xs:string"/>
      <xs:element name="email"                type="xs:string"/>
      <xs:element name="telefono"             type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipoReceptor">
    <xs:sequence>
      <xs:element name="nombre"    type="xs:string"/>
      <xs:element name="id_fiscal" type="xs:string"/>
      <xs:element name="telefono"  type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipoDireccion">
    <xs:sequence>
      <xs:element name="calle"         type="xs:string"/>
      <xs:element name="codigo_postal" type="xs:string"/>
      <xs:element name="poblacion"     type="xs:string"/>
      <xs:element name="provincia"     type="xs:string"/>
      <xs:element name="pais"          type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipoLineas">
    <xs:sequence>
      <xs:element name="linea" type="tipoLinea" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipoLinea">
    <xs:sequence>
      <xs:element name="concepto"        type="xs:string"/>
      <xs:element name="descripcion"     type="xs:string"/>
      <xs:element name="precio_unitario" type="xs:decimal"/>
      <xs:element name="unidades"        type="xs:positiveInteger"/>
      <xs:element name="subtotal"        type="xs:decimal"/>
      <xs:element name="iva_porcentaje"  type="xs:decimal"/>
      <xs:element name="total"           type="xs:decimal"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipoResumen">
    <xs:sequence>
      <xs:element name="base_imponible" type="xs:decimal"/>
      <xs:element name="iva_porcentaje" type="xs:decimal"/>
      <xs:element name="cuota_iva"      type="xs:decimal"/>
      <xs:element name="total"          type="xs:decimal"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipoPago">
    <xs:sequence>
      <xs:element name="iban" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="metodo" type="xs:string" use="required"/>
  </xs:complexType>

</xs:schema>
