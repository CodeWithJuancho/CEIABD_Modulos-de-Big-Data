<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- tp = todos los publicos -->
  <xs:simpleType name="tipoEdad">
    <xs:restriction base="xs:string">
      <xs:enumeration value="tp"/>
      <xs:enumeration value="8"/>
      <xs:enumeration value="12"/>
      <xs:enumeration value="16"/>
      <xs:enumeration value="18"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoTitulo">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="200"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoNombre">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Duracion en minutos -->
  <xs:simpleType name="tipoDuracion">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="600"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="cartelera">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="pelicula" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="titulo" type="tipoTitulo"/>
              <!-- Solo en peliculas no espanolas: opcional -->
              <xs:element name="titulo_original" type="tipoTitulo" minOccurs="0"/>
              <xs:element name="nacionalidad" type="tipoNombre"/>
              <xs:element name="genero" type="tipoNombre"/>
              <xs:choice>
                <xs:element name="clasificacion">
                  <xs:complexType>
                    <xs:attribute name="edad" type="tipoEdad" use="required"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="sin_clasificar">
                  <xs:complexType/>
                </xs:element>
              </xs:choice>
              <xs:element name="sinopsis" type="xs:string"/>
              <xs:element name="director" type="tipoNombre"/>
              <xs:element name="reparto">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="actor" type="tipoNombre" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="web" type="xs:anyURI" minOccurs="0"/>
              <xs:element name="cartel" type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="codigo" type="xs:ID" use="required"/>
            <xs:attribute name="duracion" type="tipoDuracion" use="required"/>
            <xs:attribute name="ano" type="xs:gYear" default="2003"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
