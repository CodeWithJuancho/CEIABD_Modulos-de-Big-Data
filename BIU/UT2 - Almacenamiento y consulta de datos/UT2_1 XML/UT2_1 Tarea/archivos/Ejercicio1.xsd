<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Importes y precios con coma o punto decimal y hasta 2 decimales -->
  <xs:simpleType name="tipoImporte">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+([.,][0-9]{1,2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- La fecha del documento usa el formato dd-mm-aaaa -->
  <xs:simpleType name="tipoFecha">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{2}-[0-9]{2}-[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoCodPostal">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoCif">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]-?[0-9]{7}[0-9A-Z]?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoIva">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,2}([.,][0-9]{1,2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoFormaPago">
    <xs:restriction base="xs:string">
      <xs:enumeration value="efectivo"/>
      <xs:enumeration value="tarjeta"/>
      <xs:enumeration value="plazos"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Telefono / fax: vacio o el valor fijo de la empresa -->
  <xs:simpleType name="tipoTelefonoEmpresa">
    <xs:restriction base="xs:string">
      <xs:pattern value="(917776688)?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoFaxEmpresa">
    <xs:restriction base="xs:string">
      <xs:pattern value="(917776699)?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="factura">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="datos_empresa">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nombre" type="xs:string"/>
              <xs:element name="dir" type="xs:string"/>
              <xs:element name="poblacion">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="cod_postal" type="tipoCodPostal" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="provincia" type="xs:string"/>
              <xs:element name="cif" type="tipoCif"/>
              <xs:element name="telefono" type="tipoTelefonoEmpresa" minOccurs="0"/>
              <xs:element name="fax" type="tipoFaxEmpresa" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="datos_cliente">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nombre" type="xs:string"/>
              <xs:element name="dir_env" type="xs:string"/>
              <xs:element name="poblacion">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="cod_postal" type="tipoCodPostal" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="provincia" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="n_cli" type="xs:ID" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="datos_factura">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="fecha" type="tipoFecha"/>
              <xs:element name="linea" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ref" type="xs:string"/>
                    <xs:element name="desc" type="xs:string"/>
                    <xs:element name="cant" type="xs:positiveInteger"/>
                    <xs:element name="precio" type="xs:decimal"/>
                    <xs:element name="importe" type="tipoImporte"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="base" type="tipoImporte"/>
              <xs:element name="cuota_iva" type="tipoImporte"/>
              <xs:element name="total" type="tipoImporte"/>
            </xs:sequence>
            <xs:attribute name="n_ped" type="xs:ID" use="required"/>
            <xs:attribute name="iva" type="tipoIva" use="required"/>
            <xs:attribute name="f_pago" type="tipoFormaPago" use="required"/>
            <xs:attribute name="moneda" type="xs:string" use="required" fixed="euro"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="n_fac" type="xs:ID" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
