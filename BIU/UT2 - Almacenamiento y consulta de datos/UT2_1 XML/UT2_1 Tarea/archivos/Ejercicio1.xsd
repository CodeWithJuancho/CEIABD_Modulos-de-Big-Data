<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- ============================================================ -->
  <!-- XML Schema para Ejercicio1.xml - Factura Equipos Digitales   -->
  <!-- ============================================================ -->
  <xs:element name="factura">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="datos_empresa" type="tipoEmpresa"/>
        <xs:element name="datos_cliente" type="tipoCliente"/>
        <xs:element name="datos_factura" type="tipoFactura"/>
      </xs:sequence>
      <xs:attribute name="n_fac" type="xs:ID" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Datos de la empresa -->
  <xs:complexType name="tipoEmpresa">
    <xs:sequence>
      <xs:element name="nombre"    type="xs:string"/>
      <xs:element name="dir"       type="xs:string"/>
      <xs:element name="poblacion" type="tipoPoblacion"/>
      <xs:element name="provincia" type="xs:string"/>
      <xs:element name="cif"       type="xs:string"/>
      <xs:element name="telefono"  type="xs:string" minOccurs="0"/>
      <xs:element name="fax"       type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Población con código postal -->
  <xs:complexType name="tipoPoblacion">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="cod_postal" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Datos del cliente -->
  <xs:complexType name="tipoCliente">
    <xs:sequence>
      <xs:element name="nombre"    type="xs:string"/>
      <xs:element name="dir_env"   type="xs:string"/>
      <xs:element name="poblacion" type="tipoPoblacion"/>
      <xs:element name="provincia" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="n_cli" type="xs:ID" use="required"/>
  </xs:complexType>

  <!-- Datos de la factura -->
  <xs:complexType name="tipoFactura">
    <xs:sequence>
      <xs:element name="fecha"     type="xs:string"/>
      <xs:element name="linea"     type="tipoLinea" maxOccurs="unbounded"/>
      <xs:element name="base"      type="xs:string"/>
      <xs:element name="cuota_iva" type="xs:string"/>
      <xs:element name="total"     type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="n_ped"   type="xs:ID"      use="required"/>
    <xs:attribute name="iva"     type="xs:NMTOKEN" use="required"/>
    <xs:attribute name="f_pago"  use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="efectivo"/>
          <xs:enumeration value="tarjeta"/>
          <xs:enumeration value="plazos"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="moneda" type="xs:string" fixed="euro"/>
  </xs:complexType>

  <!-- Línea individual -->
  <xs:complexType name="tipoLinea">
    <xs:sequence>
      <xs:element name="ref"     type="xs:string"/>
      <xs:element name="desc"    type="xs:string"/>
      <xs:element name="cant"    type="xs:positiveInteger"/>
      <xs:element name="precio"  type="xs:decimal"/>
      <xs:element name="importe" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
