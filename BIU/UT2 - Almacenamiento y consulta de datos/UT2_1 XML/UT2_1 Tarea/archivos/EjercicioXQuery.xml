<!-- 4 Libros y autores -->
<!-- Creen una consulta XQuery para mostrar todos los libros y sus autores. Si un libro tiene más de
un autor, muestren el primero de ellos seguido de «y otros». -->
<!-- Consulta:
for $b in doc("EjercicioXQuery.xml")/bib/libro
let $a := ($b/autor | $b/editor)
return <libro>
          <titulo>{ normalize-space($b/titulo) }</titulo>
          <autores>{
            if (count($a) > 1)
            then concat(string($a[1]/apellido), " y otros")
            else string($a[1]/apellido)
          }</autores>
       </libro>

Resultado (4 libros):
<libro><titulo>TCP/IP Illustrated</titulo><autores>Stevens</autores></libro>
<libro><titulo>Advan Programming for Unix environment</titulo><autores>Stevens</autores></libro>
<libro><titulo>Data on the Web</titulo><autores>Abiteboul y otros</autores></libro>
<libro><titulo>Economics of Technology for Digital TV</titulo><autores>Gerbarg</autores></libro> -->


