<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE facturas [
	<!ELEMENT facturas (factura+)>

	<!ELEMENT factura (emisor, receptor, fecha, lineas, resumen, pago)>
	<!ATTLIST factura
		numero ID #REQUIRED
		tipo CDATA #REQUIRED
		moneda CDATA #REQUIRED>

	<!ELEMENT emisor (nombre, direccion, identificacion_fiscal, email, telefono)>
	<!ELEMENT direccion (calle, codigo_postal, poblacion, provincia, pais)>
	<!ELEMENT calle (#PCDATA)>
	<!ELEMENT codigo_postal (#PCDATA)>
	<!ELEMENT poblacion (#PCDATA)>
	<!ELEMENT provincia (#PCDATA)>
	<!ELEMENT pais (#PCDATA)>
	<!ELEMENT identificacion_fiscal (#PCDATA)>
	<!ELEMENT email (#PCDATA)>

	<!ELEMENT receptor (nombre, id_fiscal, telefono)>
	<!ELEMENT id_fiscal (#PCDATA)>

	<!ELEMENT fecha (#PCDATA)>

	<!ELEMENT lineas (linea+)>
	<!ELEMENT linea (concepto, descripcion, precio_unitario, unidades, subtotal, iva_porcentaje, total)>
	<!ELEMENT concepto (#PCDATA)>
	<!ELEMENT descripcion (#PCDATA)>
	<!ELEMENT precio_unitario (#PCDATA)>
	<!ELEMENT unidades (#PCDATA)>
	<!ELEMENT subtotal (#PCDATA)>
	<!ELEMENT iva_porcentaje (#PCDATA)>

	<!ELEMENT resumen (base_imponible, iva_porcentaje, cuota_iva, total)>
	<!ELEMENT base_imponible (#PCDATA)>
	<!ELEMENT cuota_iva (#PCDATA)>
	<!ELEMENT total (#PCDATA)>

	<!ELEMENT pago (iban)>
	<!ATTLIST pago
		metodo CDATA #REQUIRED>
	<!ELEMENT iban (#PCDATA)>

	<!ELEMENT nombre (#PCDATA)>
	<!ELEMENT telefono (#PCDATA)>
]>
