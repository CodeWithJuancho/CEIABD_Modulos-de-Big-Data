{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ejecutar XQuery actual con Saxon",
            "type": "shell",
            "command": "java -cp /home/antonio/saxon/saxon-he-12.10.jar net.sf.saxon.Query -q:${file}",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
		},
		{
			"type": "xslt-js",
			"label": "EjercicioXSLT1 with Ejercicio4.xml (SaxonJS)",
			"xsltFile": "${workspaceFolder}/BIU/UT2 - Almacenamiento y consulta de datos/UT2_1 XML/UT2_1 Tarea/archivos/EjercicioXSLT1.xslt",
			"xmlSource": "${workspaceFolder}/BIU/UT2 - Almacenamiento y consulta de datos/UT2_1 XML/UT2_1 Tarea/archivos/Ejercicio4.xml",
			"resultPath": "${command:xslt-xpath.pickResultFile}",
			"group": {
				"kind": "build"
			}
		}
    ]
}
